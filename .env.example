# Copy to .env and fill in. .env is ignored by git.

# Secret signing the session cookie, 32 bytes in hex.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WSSH_COOKIE_SECRET=

# First user and Administrator, created only when the users table is empty.
# Username: Latin letters, digits, '.', '_', '-'; password: at least 8
# characters.
WSSH_INIT_USER=
WSSH_INIT_PASSWORD=

# Host port to connect to over HTTPS (https://<host>:<port>). Default: 4433.
WSSH_PORT=4433
